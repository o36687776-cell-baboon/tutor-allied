<?php
/**
 * Pi Payment Approval Endpoint - Enhanced Sandbox Version
 * Called when payment is ready for server approval
 * Handles Pi Network sandbox authentication and payment approval
 */

header('Content-Type: application/json');
include '../pi_config.php';

// Start session
$session_path = __DIR__ . '/../sessions';
if (!is_dir($session_path)) {
    mkdir($session_path, 0755, true);
}
if (session_status() === PHP_SESSION_NONE) {
    session_save_path($session_path);
    session_start();
}

// Log all requests for debugging
error_log('Payment Approval Request: ' . json_encode($_POST) . ' | Session: ' . session_id());

// Check authentication
if (!isset($_SESSION['user_id'])) {
    error_log('Payment approval failed: User not authenticated');
    echo json_encode([
        'success' => false,
        'error' => 'User not authenticated'
    ]);
    exit;
}

$user_id = $_SESSION['user_id'];

// Get payment data
$input = json_decode(file_get_contents('php://input'), true);
$payment_id = $input['paymentId'] ?? '';
$payment_type = $input['type'] ?? 'unknown';

if (!$payment_id) {
    error_log('Payment approval failed: Payment ID required');
    echo json_encode([
        'success' => false,
        'error' => 'Payment ID required'
    ]);
    exit;
}

// Verify payment exists and belongs to user (sandbox check)
$existing_payment = fetchOne("SELECT * FROM payments WHERE pi_payment_id = ? AND user_id = ?", [$payment_id, $user_id]);
if ($existing_payment) {
    error_log("Payment already exists for user $user_id, payment $payment_id");
    echo json_encode([
        'success' => true,
        'message' => 'Payment already approved',
        'existing' => true
    ]);
    exit;
}

// Call Pi Network Sandbox API to approve payment
$url = PI_API_BASE_URL . '/v2/payments/' . $payment_id . '/approve';
$data = [
    'user_id' => $user_id,
    'sandbox' => true,
    'approved_by' => 'ai-academy-server'
];

error_log("Approving payment $payment_id for user $user_id via Pi Sandbox API");

$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    'Authorization: Bearer ' . PI_APP_API_KEY,
    'Content-Type: application/json',
    'X-Sandbox-Mode: true'
]);

// Add timeout and error handling
curl_setopt($ch, CURLOPT_TIMEOUT, 30);
curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 10);

$response = curl_exec($ch);
$http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
$curl_error = curl_error($ch);
curl_close($ch);

error_log("Pi API Response - Code: $http_code, Response: $response");

if ($curl_error) {
    error_log("CURL Error during payment approval: $curl_error");
    echo json_encode([
        'success' => false,
        'error' => 'Network error during payment approval',
        'details' => $curl_error
    ]);
    exit;
}

$result = json_decode($response, true);

if ($http_code >= 200 && $http_code < 300 && isset($result['status']) && $result['status'] === 'approved') {
    // Payment approved successfully by Pi Network
    error_log("Payment $payment_id approved by Pi Network for user $user_id");

    // Store payment in database
    $amount = $result['amount'] ?? 0;
    $memo = $result['memo'] ?? '';
    $description = $payment_type === 'verification' ? 'Pi Wallet Verification' : $memo;

    $payment_id_db = createPayment($user_id, $amount, 'PI', $description);
    if ($payment_id_db) {
        updatePaymentStatus($payment_id_db, 'approved', $payment_id);

        // Log the approval
        logUserActivity($user_id, 'payment_approved', 5, "Payment approved: $description ($amount π)");

        echo json_encode([
            'success' => true,
            'message' => 'Payment approved successfully by Pi Network',
            'payment_id' => $payment_id,
            'amount' => $amount,
            'type' => $payment_type
        ]);
    } else {
        error_log("Failed to create payment record in database for user $user_id");
        echo json_encode([
            'success' => false,
            'error' => 'Failed to record payment in database'
        ]);
    }
} else {
    error_log("Pi Network payment approval failed - Code: $http_code, Response: " . json_encode($result));
    echo json_encode([
        'success' => false,
        'error' => 'Pi Network payment approval failed',
        'http_code' => $http_code,
        'details' => $result
    ]);
}
?>